# Copy to deploy/.env on the server. Do not commit actual values.
# Pin immutable digests obtained after building the release images.
BACKEND_IMAGE=registry.example/jibro-backend@sha256:REPLACE
WEB_IMAGE=registry.example/jibro-web@sha256:REPLACE
PUBLIC_HOST=app.example.com
TLS_DIRECTORY=/etc/jibro/tls
ACME_DIRECTORY=/var/lib/jibro/acme
RDS_CA_FILE=/etc/jibro/rds/global-bundle.pem
