# Copy to runtime.env; chmod 600. This file is passed only to the backend.
# Compose env_file format: raw preserves dollar signs and JSON without expansion.
DB_URL=jdbc:postgresql://REPLACE.rds.amazonaws.com:5432/jibro?sslmode=verify-full&sslrootcert=/run/rds-ca/global-bundle.pem
DB_USERNAME=jibro_app
DB_PASSWORD=REPLACE
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
FRONTEND_URL=https://app.example.com
# Optional connections. Leave disabled until credentials are available.
LH_SERVICE_KEY=
LH_COLLECTION_CATEGORY_CODES=06,13
LH_COLLECTION_HISTORY_START_DATE=2000-01-01
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
JIBRO_MAIL_FROM=
JIBRO_SMTP_STARTTLS=true
JIBRO_SMTP_AUTH=true
JIBRO_VAPID_JWK=
JIBRO_PUSH_SUBJECT=
GOOGLE_CLIENT_ID=
# Production OAuth callbacks use FRONTEND_URL; an override must have the same origin.
OAUTH_BASE_URL=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
