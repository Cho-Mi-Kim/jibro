POSTGRES_DB=jibro
POSTGRES_USER=jibro
POSTGRES_PASSWORD=replace-with-your-own-local-password
POSTGRES_PORT=15432
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# false is only for local HTTP. Production must use HTTPS and true.
AUTH_SECURE_COOKIE=false
FRONTEND_URL=http://127.0.0.1:5173
# Optional OAuth providers: configure registered redirect URIs before enabling.
# Local callback default: http://127.0.0.1:8080. Production defaults to FRONTEND_URL.
# OAUTH_BASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Public data portal LH API: use the decoded service key, not the URL-encoded key.
# LH_SERVICE_KEY=
# Explicit publication range and categories; validate API quota before live collection.
LH_COLLECTION_CATEGORY_CODES=06,13
LH_COLLECTION_HISTORY_START_DATE=2000-01-01
# Compare corrections and follow-up official announcements in the automatic review worker.
AUTOMATIC_FOLLOWUP_ENABLED=true
AUTOMATIC_FOLLOWUP_POLL_MS=60000
# Verify official correction identities after collection; one durable queued check per tick.
AUTOMATIC_CORRECTION_ENABLED=true
AUTOMATIC_CORRECTION_POLL_MS=30000
# Optional local OCR for scanned official PDFs and HWP images; no API key or document upload.
# Set both absolute paths. The data directory must contain kor.traineddata, eng.traineddata and osd.traineddata.
# These are examples for this Windows checkout; use actual paths on another machine.
# JIBRO_OCR_EXECUTABLE=C:/Program Files/Tesseract-OCR/tesseract.exe
# JIBRO_OCR_DATA_PATH=C:/Users/Administrator/Documents/jibro/.tools/tessdata
# Limits, Linux setup and verified model hashes: docs/contracts/official-text-extraction.md
# Optional real email delivery; absent settings use local pickup only in local-sample.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# JIBRO_MAIL_FROM=
# Optional payload-free Web Push, server private JWK only (never frontend env).
# JIBRO_VAPID_JWK=
# JIBRO_PUSH_SUBJECT=
# Production deployment examples and validation: deploy/README.md
# Gemini document interpretation (server only). Integration is optional; never use VITE_ for this key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REVIEW_ENABLED=false
# Local caps are stricter than provider quota; they do not change Google's billing tier.
# GEMINI_REVIEW_DAILY_LIMIT=10
# GEMINI_REVIEW_INTERVAL_SECONDS=60
# Official guide checks: daily 06:00 Asia/Seoul, with restart catch-up.
# Reuses the server Gemini key and the same global request budget when source text changes.
GUIDE_REFRESH_ENABLED=true
# Defaults to GEMINI_REVIEW_ENABLED; false still checks source availability and unchanged content.
# GUIDE_REFRESH_AI_ENABLED=false
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
