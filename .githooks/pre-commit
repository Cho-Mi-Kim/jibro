#!/bin/sh
if ! command -v node >/dev/null 2>&1; then
    echo '[project-history] Node.js를 찾지 못해 자동 기록을 생략합니다. 기록을 수동 보완해 주세요.' >&2
    exit 0
fi
node scripts/project-history.mjs hook
history_status=$?
if [ "$history_status" -ne 0 ]; then
    echo '[project-history] 자동 기록을 완료하지 못했습니다. 위 원인을 확인하고 기록을 수동 보완해 주세요. 커밋은 계속 진행합니다.' >&2
fi
exit 0
